; Routing layer only: maps incoming event verbs to the presentation handlers
; defined in avatar.zscheme. Load avatar.zscheme first. Replies to
; command-initiated RPCs (look, who?, exits?, …) are handled inline by each
; verb procedure in avatar.zscheme, not through a dispatch table here — a
; reply is the direct return value of the RPC call that requested it, so
; there's nothing generic left to route.

(define event-handlers
  (make-map ":print" event-print
            ":arrive" event-arrive
            ":leave" event-leave
            ":say" event-say
            ":emote" event-emote
            ":take" event-take
            ":drop" event-drop
            ":dig" event-dig
            ":fill" event-fill))

; Any broadcast that can change who/what is present or reachable in this
; room — someone else arriving/leaving/taking/dropping/digging/filling —
; makes the cached `last-room` snapshot (avatar.zscheme) stale. Without this,
; resolve-room-pool keeps serving the old who/things/exits list forever (it
; only ever refreshes on a cache miss or an explicit `look`), so hold/take/
; drop/put/claim/owner/recycle can match a ghost that has since left, or miss
; someone who just arrived — the intermittent "sometimes 2 duckies, sometimes
; none" symptom.
(define room-invalidating-events
  (list ":arrive" ":leave" ":take" ":drop" ":dig" ":fill"))

(define (on-event event args)
  (when (contains? room-invalidating-events event)
    (set! last-room #f))
  (let ((handler (map-ref event-handlers event #f)))
    (if handler (apply handler args) ())))

;; lambda-ma runtime.zscheme v0.1
;;
;; This file is the runtime-side library surface for the lambda-ma profile.
;; It is intentionally not a generic stdlib export: it owns the object-ref
;; lookup contract that a room/avatar client can call through the runtime layer.
;;
;; Load stdlib first, then this file:
;;
;;   (include ".my.doc.stdlib")
;;   (include ".my.doc.runtime")
;;
;; Save to .my.doc.runtime:
;;   .my.doc.runtime!edit
;;
;; Publish:   .my.doc.runtime!publish @ma
;; Fetch:     .my.doc.runtime!fetch /ipfs/<cid>

;; ── Address parsing ───────────────────────────────────────────────────────────
;;
;; Addresses follow the form:  [avatar@]runtime[#room]
;;
;;   "alice@sky#room"  →  ("alice"  "@sky"  "#room")
;;   "@sky#room"       →  (#f       "@sky"  "#room")
;;   "@sky"            →  (#f       "@sky"  #f)
;;
;; runtime is always returned with its @ sigil.
;; room    is always returned with its # sigil, or #f when absent.

(define ENTER  ":enter")
(define CLAIM  ":claim")
(define AVATAR "#avatar")

(define (parse-address addr)
  (let* ((at-idx  (string-index addr "@"))
         (hs-idx  (string-index addr "#"))
         (len     (string-length addr))
         (avatar  (if (and at-idx (> at-idx 0))
                      (substring addr 0 at-idx)
                      #f))
         (rt-start (if at-idx (+ at-idx 1) 0))
         (rt-end   (if hs-idx hs-idx len))
         (runtime  (string-append "@" (substring addr rt-start rt-end)))
         (room     (if hs-idx (substring addr hs-idx len) #f)))
    (list avatar runtime room)))

(define (address-avatar  p) (car   p))
(define (address-runtime p) (cadr  p))
(define (address-room    p) (caddr p))

;; ── Individual steps ──────────────────────────────────────────────────────────

;; Claim (or update) your display name on a runtime.
;; (claim-alias "@sky" "alice")  →  avatar-id string
(define (claim-alias runtime name)
  (let ((r (rpc-send (string-append runtime AVATAR) CLAIM name)))
    (if (ok? r)
        (ok-val r)
        (error (string-append "claim-alias: " (err-msg r))))))

;; Enter a room directly.
;; room must include the # sigil, e.g. "#room".
;; (enter-room "@sky" "#room")  →  room's welcome reply
(define (enter-room runtime room)
  (let ((r (rpc-send (string-append runtime room) ENTER)))
    (if (ok? r)
        (ok-val r)
        (error (string-append "enter-room: " (err-msg r))))))

;; ── Shared object reference resolver ────────────────────────────────────────
;;
;; This runtime library owns the lambda-ma resolver contract. `resolve-ref` is
;; runtime-domain code and is not part of the generic stdlib. The minimum
;; public shape is: a lookup word plus a candidate pool of ctx maps. The result
;; is a plain list of DID strings only — one-element list for a unique answer,
;; multi-element list for ambiguity, empty list for no match. Any presentation
;; layer is a caller concern.
;; `unique-list` is the generic stdlib helper that resolves duplicates inside the
;; result set.

(define (flatten-list vals)
  (cond ((null? vals) ())
        ((list? (car vals)) (append (flatten-list (car vals)) (flatten-list (cdr vals))))
        (else (cons (car vals) (flatten-list (cdr vals))))))

(define (name-matches? word entry key)
  (let* ((value (map-ref entry key #f))
         (needle (string-downcase word))
         (haystack (if (string? value) (string-downcase value) "")))
    (and (string? value)
         (or (equal? needle haystack)
             (string-contains haystack needle)))))

(define (candidates-by-keys word pool keys)
  (if (null? keys)
    ()
    (let ((hits (filter (lambda (entry) (name-matches? word entry (car keys))) pool)))
      (if (null? hits)
        (candidates-by-keys word pool (cdr keys))
        hits))))

(define (resolve-in-pool word pool keys)
  (let ((candidates (candidates-by-keys word pool keys)))
    (if (null? candidates)
      ()
      (map (lambda (entry) (map-ref entry "actor" (map-ref entry "did" #f))) candidates))))

(define (resolve-attr word pool attr)
  (resolve-in-pool word pool (list attr)))

(define (resolve-name word pool)
  (resolve-attr word pool "name"))

(define (resolve-nick word pool)
  (resolve-attr word pool "nick"))

(define (resolve-description word pool)
  (resolve-attr word pool "description"))

(define (resolve-ref word pool)
  (unique-list
    (flatten-list (list (resolve-name word pool)
                         (resolve-nick word pool)
                         (resolve-description word pool)))))

;; ── Composite ─────────────────────────────────────────────────────────────────
;;
;; (enter "alice@sky#room")  — claim avatar name, enter room.
;; (enter "@sky#room")       — skip avatar claim, enter room.
;;
;; Returns the room's welcome reply.
(define (enter addr)
  (let* ((p       (parse-address addr))
         (avatar  (address-avatar  p))
         (runtime (address-runtime p))
         (room    (address-room    p)))
    (when (equal? runtime "@")
      (error (string-append "enter: no runtime in address: " addr)))
    (unless room
      (error (string-append "enter: no room in address: " addr)))
    (when avatar
      (claim-alias runtime avatar))
    (enter-room runtime room)))

(define (fib n)
  (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
